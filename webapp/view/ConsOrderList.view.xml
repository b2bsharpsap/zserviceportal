<mvc:View
    controllerName="zserviceportal.controller.ConsOrderList"
    xmlns="sap.m"
    xmlns:l="sap.ui.layout"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:t="sap.ui.table"
    xmlns:core="sap.ui.core"
>
    <!--
         height="100%">
        Equipment List grid.
        Uses sap.ui.table.Table because the requirements call for:
          - per-column sort & filter
          - configurable visibility
          - export to Excel
          - row multi-selection (checkbox)
        sap.ui.table.Table exposes column header menus that ship with
        these capabilities out of the box.
    -->
    <Page
        title="{i18n>pageOrdersList}"
        showNavButton="false"
        busy="{view>/busy}"
        busyIndicatorDelay="0"
    >
        <!-- ─────── Sub-header: Customer Info ─────── -->
        <customHeader>
            <Bar>
                <contentLeft>
                    <Title
                        text="{i18n>pageOrdersList}"
                        level="H2"
                    />
                </contentLeft>

                <contentRight>
                    <!--
                    <Button
                        icon="sap-icon://person-placeholder"
                        text="{view>/userName}"
                        type="Transparent"
                    />
                    -->
                    <Button
                        text="Back"
                        type="Transparent"
                        press="onPressBackButton"
                    />
                </contentRight>
            </Bar>
        </customHeader>
     
        <HBox class="sapUiTinyMarginTop">
            <VBox>
                <Toolbar
                    class="sapUiTinyMarginTop"
                    width="30rem"
                >
                    <Label
                        text="{i18n>lblCustomer}"
                        class="spHeaderLabel"
                        width="8rem"
                    />
                    <Text
                        id="txtOrderCustName"
                        visible="true"
                        text=""
                    />
                    
                </Toolbar>
                 <Toolbar
                    class="sapUiTinyMarginTop "
                    width="28rem"
                >
                    <Label
                        id="idLblAddress134"
                        text="{i18n>lblAddress}"
                        class="spHeaderLabel"
                        width="8rem"
                    />
                    <Text
                        id="txtOrderCustAddress"
                        text="13409 CARMENITA RD, CA, US"                        
                        visible="true"
                    />
                </Toolbar>
                <Toolbar
                    class="sapUiTinyMarginTop "
                    width="28rem"
                >
                    <Label
                        text="Sharp Order:"
                        width="8rem"
                    />
                    <Input
                        id="inpSharpOrder"
                        value="{/search/equipmentId}"
                        width="9rem"
                    />
                </Toolbar>
                <Toolbar
                    class="sapUiTinyMarginTop "
                    width="28rem"
                >
                    <Label
                        text="Sharp Equip ID:"
                        width="8rem"
                    />
                    <Input
                        id="inpSharpEquipId"
                        value="{/search/customerEquipmentId}"
                        width="9rem"
                    />
                </Toolbar>             
                   
                <Toolbar
                    class="sapUiTinyMarginTop"
                    width="28rem"
                >
                    <CheckBox
                        id="cbAudited123"
                        text="Open"
                        selected="true"
                        select="onSelectChkBox"
                    />
                    <CheckBox
                        id="cbMissAttach343"
                        text="Closed"
                        select="onSelectChkBox"
                    />
                </Toolbar>
                   
                <Toolbar
                    class="sapUiTinyMarginTop "
                    width="28rem"
                >
                    <Button
                        id="btnOrderSearch"
                        text="Search"
                        visible="{= !${/selectedEquipment/NoAccess}}"
                        class="spOpenEquipmentBtn sapUiTinyMarginEnd"
                        press=".searchConsOrderList"
                    />
                    <Input
                        id="inpCustomerEquipmentId112334"
                        value="{/search/customerEquipmentId}"
                        width="9rem"
                        visible="false"
                    />
                </Toolbar>
            </VBox>
            <VBox>
               
                <Toolbar
                    class="sapUiTinyMarginTop "
                    width="28rem"
                >
                    <Label
                        text="{i18n>lblModel}"
                        width="8rem"
                    />
                    <Input
                        id="inpOrderModel"
                        value="{/search/model}"
                        width="9rem"
                    />
                </Toolbar>
                <Toolbar
                    class="sapUiTinyMarginTop "
                    width="28rem"
                >
                    <Label
                        text="{i18n>lblSerial}"
                        width="8rem"
                    />
                    <Input
                        id="inpOrderSerial"
                        value="{/search/serial}"
                        width="9rem"
                    />
                </Toolbar>

                <Toolbar
                    class="sapUiTinyMarginTop "
                    width="28rem"
                >
                    <Label
                        text="Order Reference:"
                        width="8rem"
                    />
                    <Input
                        id="inpOrderRef"
                        value="{/search/serial}"
                        width="9rem"
                    />
                </Toolbar>

                      <Toolbar
                    class="sapUiTinyMarginTop "
                    width="28rem"
                >
                    <Label
                        text="Supply Product ID:"
                        width="8rem"
                    />
                    <Input
                        id="inpCustomerEquipmentId2212"
                        value="{/search/customerEquipmentId}"
                        width="9rem"
                    />
                </Toolbar>
                   
                <Toolbar
                    class="sapUiTinyMarginTop "
                    width="100%"
                >
                    <Label
                        text="By Date:"
                        width="4rem"
                    />
                    
                    <DatePicker
                        id="idOrderFromDate"
                        placeholder="From Date"
                        change="handleFromDateChng"
                        width="8rem"
                        valueFormat="yyyyMMdd"
                        value=""
                    />
                   
                    <DatePicker
                        id="idOrderToDate"
                        placeholder="To Date"
                        change="handleToDateChng"
                        width="8rem"
                        valueFormat="yyyyMMdd"
                        value=""
                    />
                </Toolbar>                              

            </VBox>
        </HBox>

        <t:Table
            id="tblConsOrdersList"
            class="sapUiSmallMarginTop"
            rows="{modelServiceReq>/results}"
            selectionMode="Single"
            selectionBehavior="RowSelector"
            enableColumnReordering="true"
            enableColumnFreeze="true"
            enableSelectAll="true"
            rowSelectionChange=".onRequestSelection"
            ariaLabelledBy="ttlEquipmentList"
        >
            <t:extension>
                <OverflowToolbar>
                    <Title
                        id="ttlConsOrdersList"
                        text="Consumable Orders List"
                        level="H4"
                    />
                    <ToolbarSpacer />

                    <!-- Free text search across the grid -->
                    <SearchField
                        width="20rem"
                        placeholder="{i18n>btnSearch}"
                        search=".onSearch"
                        liveChange=".onSearchLive"
                    />

                    <!-- Export to Excel -->

                    <Image
                        press="onExportToExcel"
                        src="images/icon_export_excel.png"
                        tooltip="Export to Excel"
                    />
                    <!-- Configure columns to display or hide -->
                    <Image
                        id="imgConfigureCols123"
                        press="onConfigureColumns"
                        src="images/icon_settings.png"
                        tooltip="Configure Columns"
                    />
                </OverflowToolbar>
            </t:extension>

            <t:columns>
                <!-- Equipment ID  (hyperlink) -->
                <t:Column
                    width="7rem"
                    sortProperty="EtOrderList/Order"
                    filterProperty="EtOrderList/Order"
                    autoResizable="true"
                    tooltip="Sharp Order ID"
                >
                    <t:label>
                        <Label text="Sharp Order ID:" />
                    </t:label>

                    <!--
                    <t:template>
                        <Text text="{modelServiceReq>EtOrderList/Order}" />                       
                    </t:template>
                    -->


                    <t:template>
                        <Link
                        text="{modelServiceReq>EtOrderList/Order}"
                        press=".onSharpOrderPress" />
                        </t:template>       



                </t:Column>

                <!-- Customer Equipment ID  (hyperlink) -->
                <t:Column
                    width="7rem"
                    sortProperty="CreateDate"
                    filterProperty="CreateDate"
                    autoResizable="true"
                >
                    <t:label>
                        <Label text="Date" />
                    </t:label>
                    <t:template>
                        <Text text="{modelServiceReq>EtOrderList/CreateDate}" />
                    </t:template>
                </t:Column>

                <!-- Model -->
                <t:Column
                    width="7rem"
                    sortProperty="EtOrderList/Description"
                    filterProperty="EtOrderList/Description"
                    autoResizable="true"
                >
                    <t:label>
                        <Label text="Description" />
                    </t:label>
                    <t:template>
                        <Text
                            text="{modelServiceReq>EtOrderList/Description}"
                            wrapping="true"
                        />
                    </t:template>
                </t:Column>

                <!-- Serial Number -->
                <t:Column
                    width="8rem"
                    sortProperty="EtOrderList/ExRef"
                    filterProperty="EtOrderList/ExRef"
                    autoResizable="true"
                >
                    <t:label>
                        <Label text="Order Reference" />
                    </t:label>
                    <t:template>
                        <Text text="{modelServiceReq>EtOrderList/ExRef}" />
                    </t:template>
                </t:Column>

                
                <!-- Open Service Request  (hyperlink) -->
                <t:Column
                    width="7rem"
                    sortProperty="EtOrderList/Status"
                    filterProperty="EtOrderList/Status"
                    autoResizable="true"
                >
                    <t:label>
                        <Label text="Order Status" />
                    </t:label>
                    <t:template>
                        <Text text="{modelServiceReq>EtOrderList/Status}" />
                    </t:template>
                </t:Column>

                <!-- Open Service Request  (hyperlink) -->
                <t:Column
                    width="7rem"
                    sortProperty="EtOrderList/StatusDate"
                    filterProperty="EtOrderList/StatusDate"
                    autoResizable="true"
                >
                    <t:label>
                        <Label text="Status Time" />
                    </t:label>
                    <t:template>
                        <Text text="{modelServiceReq>EtOrderList/StatusDate}" />
                    </t:template>
                </t:Column>

                <!-- Open Order  (hyperlink) -->
                <!--
                <t:Column
                    width="8rem"
                    sortProperty="OpenOrder"
                    filterProperty="OpenOrder"
                    autoResizable="true"
                >
                    <t:label>
                        <Label text="Tracking Info" />
                    </t:label>
                    <t:template>
                        <Text text="{modelServiceReq>Country}" />
                    </t:template>
                </t:Column>
                -->
                <t:Column
                    width="7rem"
                    sortProperty="EtOrderList/EquipmentId"
                    filterProperty="EtOrderList/EquipmentId"
                    autoResizable="true"
                    tooltip="Sharp Equipment ID"
                >
                    <t:label>
                        <Label text="Sharp Equipment ID" />
                    </t:label>
                    <t:template>
                        <Text
                            text="{modelServiceReq>EtOrderList/EquipmentId}"
                            wrapping="false"
                        />
                    </t:template>
                </t:Column>

                <t:Column
                    width="7rem"
                    sortProperty="EtOrderList/CustEquip"
                    filterProperty="EtOrderList/CustEquip"
                    autoResizable="true"
                >
                    <t:label>
                        <Label text="Customer Equipment ID" />
                    </t:label>
                    <t:template>
                        <Text
                            text="{modelServiceReq>EtOrderList/CustEquip}"
                            wrapping="false"
                        />
                    </t:template>
                </t:Column>

                <t:Column
                    width="7rem"
                    sortProperty="EtOrderList/Model"
                    filterProperty="EtOrderList/Model"
                    autoResizable="true"
                >
                    <t:label>
                        <Label text="Model" />
                    </t:label>
                    <t:template>
                        <Text
                            text="{modelServiceReq>EtOrderList/Model}"
                            wrapping="false"
                        />
                    </t:template>
                </t:Column>

                <t:Column
                    width="8rem"
                    sortProperty="EtOrderList/Sernr"
                    filterProperty="EtOrderList/Sernr"
                    autoResizable="true"
                >
                    <t:label>
                        <Label text="Serial" />
                    </t:label>
                    <t:template>
                        <Text
                            text="{modelServiceReq>EtOrderList/Sernr}"
                            wrapping="true"
                        />
                    </t:template>
                </t:Column>

                <t:Column
                    width="9rem"
                    sortProperty="EtOrderList/Location"
                    filterProperty="EtOrderList/Location"
                    autoResizable="true"
                >
                    <t:label>
                        <Label text="Location" />
                    </t:label>
                    <t:template>
                        <Text
                            text="{modelServiceReq>EtOrderList/Location}"
                            wrapping="true"
                        />
                    </t:template>
                </t:Column>

                <t:Column
                    width="7rem"
                    sortProperty="EtOrderList/Street"
                    filterProperty="EtOrderList/Street"
                    autoResizable="true"
                >
                    <t:label>
                        <Label text="Street" />
                    </t:label>
                    <t:template>
                        <Text
                            text="{modelServiceReq>EtOrderList/Street}"
                            wrapping="true"
                        />
                    </t:template>
                </t:Column>

                <t:Column
                    width="7rem"
                    sortProperty="EtOrderList/City1"
                    filterProperty="EtOrderList/City1"
                    autoResizable="true"
                >
                    <t:label>
                        <Label text="City" />
                    </t:label>
                    <t:template>
                        <Text
                            text="{modelServiceReq>EtOrderList/City1}"
                            wrapping="true"
                        />
                    </t:template>
                </t:Column>

                <t:Column
                    width="4rem"
                    sortProperty="EtOrderList/Region"
                    filterProperty="EtOrderList/Region"
                    autoResizable="true"
                >
                    <t:label>
                        <Label text="Region" />
                    </t:label>
                    <t:template>
                        <Text
                            text="{modelServiceReq>EtOrderList/Region}"
                            wrapping="false"
                        />
                    </t:template>
                </t:Column>                  
               
            </t:columns>
        </t:Table>

        <Panel
            headerText="Order Details"
            width="100%"
        >
            <content>
                <HBox>
                    <VBox>
                        <Toolbar width="25rem">
                            <Label
                                text="Sharp Order ID:"
                                width="10rem"
                            />
                            <Text
                                text="{modelServiceDetails>/Order}"
                            />
                        </Toolbar>

                        <Toolbar width="25rem">
                            <Label
                                text="Description:"
                                width="10rem"
                            />
                            <Text
                                text="{modelServiceDetails>/Description}"
                            />
                        </Toolbar>

                        <Toolbar width="25rem">
                            <Label
                                text="Order Status:"
                                width="10rem"
                            />
                            <Text
                                text="{modelServiceDetails>/Status}"
                            />
                        </Toolbar>

                        <Toolbar width="25rem">
                            <Label
                                text="Sharp Equipment ID:"
                                width="10rem"
                            />
                            <Text
                                text="{modelServiceDetails>/EquipmentId}"
                            />
                        </Toolbar>

                        <Toolbar width="25rem">
                            <Label
                                text="Model:"
                                width="10rem"
                            />
                            <Text
                                text="{modelServiceDetails>/Model}"
                            />
                        </Toolbar>
                        <Toolbar width="25rem">
                            <Label
                                text="Serial:"
                                width="10rem"
                            />
                            <Text
                                text="{modelServiceDetails>/Sernr}"
                            />
                        </Toolbar>

                        <Toolbar width="25rem">
                            <Label
                                text="Street:"
                                width="10rem"
                            />
                            <Text
                                text="{modelServiceDetails>/Street}"
                            />
                        </Toolbar>
                       
                        <Toolbar width="25rem">
                            <Label
                                text="Contract Terms:"
                                width="10rem"
                            />
                            <Text
                                text="{modelServiceDetails>/Terms}"
                            />
                        </Toolbar>

                       
                    </VBox>
                    <VBox>
                        <Toolbar width="25rem">
                            <Label
                                text="Date:"
                                width="8rem"
                            />
                            <Text
                                text="{modelServiceDetails>/Date}"
                            />
                        </Toolbar>
                        <Toolbar width="25rem">
                            <Label
                                text="Order Reference:"
                                width="8rem"
                            />
                            <Text
                                text="{modelServiceDetails>/Description1}"
                            />
                        </Toolbar>

                        <Toolbar width="25rem">
                            <Label
                                text="Status Time:"
                                width="8rem"
                            />
                            <Text
                                text="{modelServiceDetails>/Description1}"
                            />
                        </Toolbar>
                        <Toolbar width="25rem">
                            <Label
                                text="Customer EquipId:"
                                width="8rem"
                            />
                            <Text
                                text="{modelServiceDetails>/CustEquip}"
                            />
                        </Toolbar>
                        <Toolbar width="25rem">
                            <Label
                                text="{i18n>lblModelDescription}"
                                width="8rem"
                            />
                            <Text
                                text="{modelServiceDetails>/Description}"
                            />
                        </Toolbar>
                        <Toolbar width="25rem">
                            <Label
                                text="{i18n>lblLocation}"
                                width="8rem"
                            />
                            <Text
                                text="{modelServiceDetails>/Location2}"
                            />
                        </Toolbar>
                        <Toolbar width="25rem">
                            <Label
                                text="{i18n>lblCityStateZip}"
                                width="8rem"
                            />
                            <Text
                                text="{
                            parts: [
                                {path:'/selectedEquipment/City'},
                                {path:'/selectedEquipment/State'},
                                {path:'/selectedEquipment/Zip'}
                            ],
                            formatter: '.formatter.cityStateZip'
                        }"
                            />
                        </Toolbar>

                        <Toolbar width="25rem">
                            <Label
                                text="Tracking Info:"
                                width="10rem"
                            />
                            <Text
                                text="{modelServiceDetails>/Terms}"
                            />
                        </Toolbar>

                        
                    </VBox>
                </HBox>

                <!-- Additional Info / Request Notes as text areas -->
               
                <!-- Supplies -->
                <Title
                    text="Supplies"
                    level="H4"
                    class="sapUiSmallMarginTop"
                />
                <t:Table
                    id="tblProduct"
                    rows="{modelOrderParts>/PartsCollection}"
                    selectionMode="None"
                    xmlns:table="sap.ui.table"
                    width="100%"
                >
                    <t:columns>
                        <t:Column>
                            <Label text="Product ID" />
                            <t:template>
                                <Text text="{modelOrderParts>ProductId}" />
                            </t:template>
                        </t:Column>
                        <t:Column>
                            <Label text="Description" />
                            <t:template>
                                <Text text="{modelOrderParts>Description}" />
                            </t:template>
                        </t:Column>

                        <t:Column>
                            <Label text="Quantity" />
                            <t:template>
                                <Text
                                    text="{modelOrderParts>Quantity}"
                                />
                            </t:template>
                        </t:Column>                    
                    </t:columns>
                </t:Table>

                 <!-- Shipping Instructions text area -->
                <VBox class="sapUiSmallMarginTop" 
                      width="50%">
                    <Label text="{i18n>lblShippingInstructions}"
                           class="spHeaderLabel"
                    />
                    <TextArea
                        value="{/order/ShippingInstructions}"
                        editable="false"
                        rows="3"
                        width="100%"
                    />
                </VBox>

            </content>
        </Panel>
    </Page>
</mvc:View>

<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
>
    <Dialog
        title="Equipment List"
        contentWidth="900px"
        contentHeight="200px"
    >
        <content>
            <Table
                mode="SingleSelectMaster"
                selectionChange="onEquipmentSelect"
                items="{viewModel>/EquipmentSet}"
            >
                <columns>
                    <Column>
                        <Text text="Sharp Equipment ID" />
                    </Column>

                    <Column>
                        <Text text="Model" />
                    </Column>

                    <Column>
                        <Text text="Serial" />
                    </Column>

                    <Column>
                        <Text text="Description" />
                    </Column>

                    <Column>
                        <Text text="Location" />
                    </Column>
                </columns>

                <items>
                    <ColumnListItem>
                        <cells>
                            <Text text="{viewModel>EquipmentID}" />

                            <Text text="{viewModel>Model}" />

                            <Text text="{viewModel>Serial}" />

                            <Text text="{viewModel>Description}" />

                            <Text text="{viewModel>Location}" />
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </content>

        <endButton>
            <Button
                text="Close"
                press="onDialogClose"
            />
        </endButton>
    </Dialog>
</core:FragmentDefinition>
